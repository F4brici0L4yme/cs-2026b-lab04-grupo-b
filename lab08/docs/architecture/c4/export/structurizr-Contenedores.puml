@startuml
title <size:24>Container View: RutaSIT Arequipa</size>\n<size:24>E6: contenedores después de las tres iteraciones ADD.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Pasajero, "Pasajero", $descr="Consulta ubicación y ETA; recibe estado textual si fallan mapas. [QA-02, QA-04, QA-07]", $tags="", $link="")
Person(Operador, "Operador", $descr="Supervisa flota y administra rutas; cambios versionan geometría. [QA-01, QA-03]", $tags="", $link="")
System(RastreadorGPSdelosbuses, "Rastreador GPS de los buses", $descr="1200 unidades transmiten posición cada 10 s e ID estable. [QA-01, QA-03, QA-07]", $tags="", $link="")
System(MapasabiertosOSM, "Mapas abiertos (OSM)", $descr="Proveedor externo de tiles y geometría; su caída no elimina estado textual. [QA-02]", $tags="", $link="")

System_Boundary("RutaSITArequipa_boundary", "RutaSIT Arequipa", $tags="") {
  Container(RutaSITArequipa.WorkerETAAlertas, "Worker ETA/Alertas", $techn="Celery", $descr="Procesa 120 eventos/s como objetivo; geometría precargada por versión, Strategy ETA, ID estable. [QA-01, QA-03, QA-06, QA-07]", $tags="", $link="")
  ContainerQueue(RutaSITArequipa.Colaycaché, "Cola y caché", $techn="Redis", $descr="Cola con AOF según ADR-003; caché ETA por bus/paradero, TTL <=2 s y memoria acotada. [QA-01, QA-03, QA-04, QA-07]", $tags="", $link="")
  ContainerDb(RutaSITArequipa.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Esquemas por módulo, historial y último ETA con clave compuesta bus/paradero y captura original. [QA-01, QA-03, QA-04, QA-05, QA-07]", $tags="", $link="")
  Container(RutaSITArequipa.APIRutaSIT, "API RutaSIT", $techn="Python / Django", $descr="REST de ingesta/consulta y vista textual degradada. Lee ETA materializado, comprueba captura <=30 s y usa breaker de mapas. [QA-01, QA-02, QA-04, QA-05, QA-07]", $tags="", $link="")
}

Rel(Pasajero, RutaSITArequipa.APIRutaSIT, "Consulta ETA y estado", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Operador, RutaSITArequipa.APIRutaSIT, "Consulta panel y configura rutas", $techn="HTTPS/JSON", $tags="", $link="")
Rel(RastreadorGPSdelosbuses, RutaSITArequipa.APIRutaSIT, "Envía posición e ID estable", $techn="HTTPS/JSON", $tags="", $link="")
Rel(RutaSITArequipa.APIRutaSIT, RutaSITArequipa.Colaycaché, "Encola posiciones; lee caché ETA TTL <=2 s", $techn="Redis protocol", $tags="", $link="")
Rel(RutaSITArequipa.WorkerETAAlertas, RutaSITArequipa.Colaycaché, "Consume posiciones y publica ETA reciente", $techn="Redis protocol", $tags="", $link="")
Rel(RutaSITArequipa.APIRutaSIT, RutaSITArequipa.Basededatos, "Lee último ETA por clave; administra rutas", $techn="SQL/TCP", $tags="", $link="")
Rel(RutaSITArequipa.WorkerETAAlertas, RutaSITArequipa.Basededatos, "Lee geometría por versión; guarda historial y último ETA", $techn="SQL/TCP", $tags="", $link="")
Rel(RutaSITArequipa.APIRutaSIT, MapasabiertosOSM, "Solicita mapa: breaker 3 fallas, sondeo 30 s [QA-02]", $techn="HTTPS", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml